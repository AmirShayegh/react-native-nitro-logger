{
  "name": "react-native-nitro-logger",
  "version": "0.2.0",
  "description": "Structured, privacy-tiered logging for React Native \u2014 TS core with a native Nitro file/os_log sink",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-nitro-logger-source": "./src/index.tsx",
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./unstable": {
      "react-native-nitro-logger-source": "./src/unstable.ts",
      "require": {
        "types": "./lib/typescript/commonjs/src/unstable.d.ts",
        "default": "./lib/commonjs/unstable.js"
      },
      "import": {
        "types": "./lib/typescript/module/src/unstable.d.ts",
        "default": "./lib/module/unstable.js"
      },
      "default": "./lib/module/unstable.js"
    },
    "./eslint-plugin": "./eslint-plugin/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "docs",
    "CHANGELOG.md",
    "eslint-plugin",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/src/test",
    "!android/src/androidTest",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "codegenConfig": {
    "name": "NitroLoggerSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.margelo.nitro.nitrologger"
    }
  },
  "scripts": {
    "test": "jest",
    "example": "yarn workspace react-native-nitro-logger-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "check-docs": "./scripts/check-doc-samples.sh --target src",
    "check-docs-lib": "./scripts/check-doc-samples.sh --target lib",
    "check-eslint-consumer": "./scripts/check-eslint-consumer.sh",
    "check-android-instrumented": "./scripts/check-android-instrumented.sh",
    "check-test-reports": "./scripts/check-test-reports.sh",
    "check-mutants": "./scripts/check-mutants.sh",
    "check-package-exports": "./scripts/check-package-exports.sh",
    "check-release-bundle-consumer": "./scripts/check-release-bundle-consumer.sh",
    "check-doc-links": "./scripts/check-doc-links.sh",
    "check-parity-counts": "./scripts/check-parity-counts.sh",
    "changeset": "changeset",
    "check-podspec-tag": "./scripts/check-podspec-tag.sh",
    "release": "yarn check-doc-links && yarn check-podspec-tag && changeset publish",
    "prepublishOnly": "yarn check-doc-links && yarn check-podspec-tag"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "logging",
    "logger",
    "structured-logging",
    "nitro",
    "nitro-modules",
    "os_log",
    "logcat",
    "privacy",
    "redaction",
    "hipaa",
    "file-logging",
    "log-rotation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmirShayegh/react-native-nitro-logger.git"
  },
  "author": "Amir Shayegh <coco@shayegh.ca> (https://github.com/AmirShayegh)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AmirShayegh/react-native-nitro-logger/issues"
  },
  "homepage": "https://github.com/AmirShayegh/react-native-nitro-logger#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-jest": "^30.4.1",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "nitrogen": "^0.36.3",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.36.3",
    "turbo": "^2.9.16",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "*",
    "eslint": ">=9.0.0",
    "react": "*",
    "react-native": ">=0.78.0",
    "react-native-nitro-modules": "^0.36.3"
  },
  "workspaces": [
    "example",
    "."
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint"
    ],
    "version": "0.63.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  }
}
