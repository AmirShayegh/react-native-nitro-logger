# React Native Nitro Modules
#
# `nitrogen/` is deliberately NOT ignored. It is generated from the `.nitro.ts`
# specs, but it is also shipped in the npm tarball and referenced by relative
# path from both build systems — and while it was ignored, the `nitrogen-diff`
# CI job could not see drift between a spec and its bindings, because there was
# nothing tracked for the regenerated output to differ from. Committing it is
# what makes that gate real. Generation is deterministic; if this ever produces
# noise in a diff, that is the bug, not the tracking.

# SwiftPM build products from the XCTest harness in Package.swift
.build/
.swiftpm/

# Machine-readable test results, written by scripts/check-test-reports.sh so it
# can assert what a run actually discovered. Deleted before each run by that
# script — tracking them would let a committed report answer for a run that
# never happened.
.jest-reports/

# Written by `yarn test:coverage`. Like .jest-reports above, a build
# artifact of a gate rather than anything to keep.
coverage/

# Generated after a commit exists, so it can name the real source commit
# without creating a self-referential tracked file. Included by npm prepack.
spec/wire/manifest.json
.wire-pack-state.json
.wire-pack-lock/

# private: backlog and scoping documents stay local
.story/
docs/internal/
